{
  "name": "chorus",
  "version": "0.1.0",
  "private": true,
  "description": "A federated video platform where speech, hosting, and reach are separate systems.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:commits": "commitlint --from=origin/main --to=HEAD",
    "check": "bash tools/check-docs-frontmatter.sh && bash tools/check-license-headers.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "markdownlint-cli2": "^0.24.0"
  },
  "workspaces": [
    "services/*",
    "clients/*"
  ]
}
