# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Environment and secrets — never commit
.env
.env.*
!.env.example

# Keys — private keys must never enter the repo
agents/keys/*.key
agents/keys/*.pem
*.pem
*.p12

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Editor/IDE
.idea/
.vscode/
!.vscode/extensions.json

# Tool caches
.cache/
.lycheecache/

# Local npm cache workaround (used when the global cache is root-owned) — never commit
.npm-cache/

# Frontend/build caches (clients in P1+)
.eslintcache
.next/
.turbo/
.parcel-cache/
.vercel/
